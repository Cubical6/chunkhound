+  checkSelections(layouted.$data.views, layouted.$data.relations);
+});
+
+function boundaryDistance([x, y]: Point, node: DiagramNode) {
+  const dx = Math.max(node.x - x, 0, x - node.x - node.width);
+  const dy = Math.max(node.y - y, 0, y - node.y - node.height);
+  if (dx || dy) return Math.hypot(dx, dy);
+  return Math.min(x - node.x, node.x + node.width - x, y - node.y, node.y + node.height - y);
+}
+
+function checkGeometry(view: LayoutedView) {
+  expect([view.bounds.x, view.bounds.y, view.bounds.width, view.bounds.height].every(Number.isFinite)).toBe(true);
+  const observed: string[] = [];
+  const routes = new Map<string, readonly Point[]>();
+  for (const edge of view.edges) {
+    const from = nonNullable(view.nodes.find((node) => node.id === edge.source));
+    const to = nonNullable(view.nodes.find((node) => node.id === edge.target));
+    const hierarchy =
+      from.children.includes(to.id) ||
+      to.children.includes(from.id) ||
+      (from.modelRef === "system" && to.modelRef === "system.app.component") ||
+      (to.modelRef === "system" && from.modelRef === "system.app.component");
+    if (!hierarchy) continue;
+    observed.push(edge.label ?? "");
+    const points = edge.dir === "back" ? [...edge.points].reverse() : edge.points;
+    expect(boundaryDistance(nonNullable(points[0]), from), `${edge.label}: source frame`).toBeLessThanOrEqual(1);
+    // Native splines stop short of the target to leave room for the normal arrowhead.
+    expect(boundaryDistance(nonNullable(points.at(-1)), to), `${edge.label}: target arrowhead`).toBeCloseTo(4.8, 5);
+    for (const point of points) {
+      expect(point.every(Number.isFinite)).toBe(true);
+      expect(point[0]).toBeGreaterThanOrEqual(view.bounds.x - 1);
+      expect(point[1]).toBeGreaterThanOrEqual(view.bounds.y - 1);
+      expect(point[0]).toBeLessThanOrEqual(view.bounds.x + view.bounds.width + 1);
+      expect(point[1]).toBeLessThanOrEqual(view.bounds.y + view.bounds.height + 1);
+    }
+    expect(edge.labelBBox, `${edge.label}: readable label`).toBeDefined();
+    const label = nonNullable(edge.labelBBox);
+    expect([label.x, label.y, label.width, label.height].every(Number.isFinite)).toBe(true);
+    expect(label.x).toBeGreaterThanOrEqual(view.bounds.x);
+    expect(label.y).toBeGreaterThanOrEqual(view.bounds.y);
+    expect(label.x + label.width).toBeLessThanOrEqual(view.bounds.x + view.bounds.width);
+    expect(label.y + label.height).toBeLessThanOrEqual(view.bounds.y + view.bounds.height);
+    for (const leaf of view.nodes.filter((node) => node.children.length === 0)) {
+      const overlaps =
+        label.x < leaf.x + leaf.width &&
+        label.x + label.width > leaf.x &&
+        label.y < leaf.y + leaf.height &&
+        label.y + label.height > leaf.y;
+      expect(overlaps, `${edge.label}: label overlaps ${leaf.id}`).toBe(false);
+    }
+    const reverse = routes.get(`${edge.target}->${edge.source}`);
+    if (reverse) expect(points).not.toEqual([...reverse].reverse());
+    routes.set(`${edge.source}->${edge.target}`, points);
+  }
+  if (view.id === "topic") {
+    expect(observed.sort()).toEqual(
+      ["r-app-component", "r-component-app", "r-sys-app", "r-app-sys", "r-sys-component", "r-component-sys"].sort(),
+    );
+  }
+}
+
+test("test_R1_R6_hierarchy_layout_uses_real_boundaries", async () => {
+  await using t = createTestServices();
+  expect((await t.validate(model)).errors).toEqual([]);
+  const layouted = await t.likec4.LanguageServices.layoutedModel();
+  for (const view of Object.values(layouted.$data.views)) checkGeometry(view);
+});
