diff --git a/packages/layouts/src/graphviz/hierarchy-edges.ts b/packages/layouts/src/graphviz/hierarchy-edges.ts
new file mode 100644
index 000000000..c6ed90374
--- /dev/null
+++ b/packages/layouts/src/graphviz/hierarchy-edges.ts
@@ -0,0 +1,66 @@
+import type { AnyAux, ComputedEdge, DiagramEdge, DiagramNode, Point, RelationshipArrowType } from "@likec4/core";
+import { EDGE_LABEL_MAX_CHARS, EDGE_LABEL_MAX_LINES, wrap } from "./dot-labels";
+
+// Visible marker tips relative to their SVG reference point, at the native 2px stroke.
+// Keep in step with diagram/base-primitives/edge/EdgeMarkers.tsx.
+const markerTipOffset: Record<RelationshipArrowType, number> = {
+  none: 0,
+  normal: 4 * (6 / 10) * 2,
+  onormal: 4 * (6 / 10) * 2,
+  crow: 0,
+  open: 2 * (8 / 16) * 2,
+  vee: 2 * (8 / 16) * 2,
+  diamond: 5 * (8 / 14) * 2,
+  odiamond: 4 * (8 / 14) * 2,
+  dot: 3 * (6 / 10) * 2,
+  odot: 3 * (6 / 10) * 2,
+};
+
+/** Route an already-authorized hierarchy relation between its real nested node boundaries. */
+export function routeHierarchyEdge<A extends AnyAux>(
+  edge: ComputedEdge<A>,
+  source: DiagramNode<A>,
+  target: DiagramNode<A>,
+): DiagramEdge<A> {
+  const downward = source.level < target.level;
+  const descendant = downward ? target : source;
+  const depth = Math.max(1, Math.abs(target.level - source.level));
+  // Opposite directions occupy opposite sides. Ancestors of different depths get distinct lanes.
+  const lane = (downward ? 0.2 : 0.6) + 0.3 * (1 - 1 / depth);
+  const x = descendant.x + descendant.width * lane;
+  const startY = downward ? source.y : source.y + source.height;
+  const endY = downward ? target.y : target.y + target.height;
+  const direction = Math.sign(endY - startY);
+  const from = startY + direction * markerTipOffset[edge.tail ?? "none"];
+  const to = endY - direction * markerTipOffset[edge.head ?? "normal"];
+  const points: [Point, Point, Point, Point] = [
+    [x, from],
+    [x, from + (to - from) / 3],
+    [x, from + ((to - from) * 2) / 3],
+    [x, to],
+  ];
+  const lines = edge.label
+    ? wrap(edge.label, {
+        maxchars: EDGE_LABEL_MAX_CHARS,
+        maxLines: EDGE_LABEL_MAX_LINES,
+      })
+    : [];
+  const label = lines.length > 0 ? lines.join("\n") : null;
+  const width = Math.max(1, ...lines.map((line) => line.length * 8)) + 12;
+  const height = lines.length * 18 + 8;
+  return {
+    ...edge,
+    label,
+    points: edge.dir === "back" ? [points[3], points[2], points[1], points[0]] : points,
+    ...(label
+      ? {
+          labelBBox: {
+            x: x + 8,
+            y: (from + to - height) / 2,
+            width,
+            height,
+          },
+        }
+      : {}),
+  };
+}
