new file mode 100644
index 000000000..447c259e0
--- /dev/null
+++ b/packages/diagram/src/chunkhound/metadata.ts
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 ChunkHound contributors
+
+/** One source range, optionally linked in public output. */
+export interface DetailSource {
+  kind: string;
+  path: string;
+  startLine: number;
+  endLine: number;
+  url: string | null;
+}
+
+interface DetailTopic {
+  title: string;
+  url: string;
+  weight: number;
+}
+
+interface DetailEndpoint {
+  id: string;
+  fqn: string;
+  title: string;
+}
+
+interface Detail {
+  version: 1;
+  status: string | null;
+  sources: DetailSource[];
+}
+
+/** Element metadata published by ChunkHound's version-one boundary. */
+export interface ElementDetail extends Detail {
+  kind: string;
+  topics: DetailTopic[];
+  focusView: string | null;
+  defaultView: string | null;
+}
+
+/** Metadata belonging to one native underlying relationship. */
+export interface RelationDetail extends Detail {
+  source: DetailEndpoint;
+  target: DetailEndpoint;
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function nullableString(value: unknown): value is string | null {
+  return value === null || typeof value === "string";
+}
+
+function source(value: unknown): value is DetailSource {
+  return (
+    record(value) &&
+    typeof value["kind"] === "string" &&
+    typeof value["path"] === "string" &&
+    Number.isInteger(value["startLine"]) &&
+    Number.isInteger(value["endLine"]) &&
+    Number(value["startLine"]) > 0 &&
+    Number(value["endLine"]) >= Number(value["startLine"]) &&
+    nullableString(value["url"])
+  );
+}
+
+function topic(value: unknown): value is DetailTopic {
+  return (
+    record(value) &&
+    typeof value["title"] === "string" &&
+    typeof value["url"] === "string" &&
+    typeof value["weight"] === "number" &&
+    Number.isFinite(value["weight"])
+  );
+}
+
+function endpoint(value: unknown): value is DetailEndpoint {
+  return (
+    record(value) &&
+    typeof value["id"] === "string" &&
+    typeof value["fqn"] === "string" &&
+    typeof value["title"] === "string"
+  );
+}
+
+function readDetail(metadata: Record<string, string | string[]> | undefined) {
+  const text = metadata?.["chunkhound_detail"];
+  if (typeof text !== "string") return null;
+  try {
+    const value: unknown = JSON.parse(text);
+    return record(value) &&
+      value["version"] === 1 &&
+      nullableString(value["status"]) &&
+      Array.isArray(value["sources"]) &&
+      value["sources"].every(source)
+      ? value
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Read the versioned element publication payload without interpreting text as markup. */
+export function elementDetail(metadata: Record<string, string | string[]> | undefined): ElementDetail | null {
+  const value = readDetail(metadata);
+  return value &&
+    typeof value["kind"] === "string" &&
+    Array.isArray(value["topics"]) &&
+    value["topics"].every(topic) &&
+    nullableString(value["focusView"]) &&
+    nullableString(value["defaultView"])
+    ? (value as unknown as ElementDetail)
+    : null;
+}
+
+/** Read one underlying relation's payload, never an aggregate edge status. */
+export function relationDetail(metadata: Record<string, string | string[]> | undefined): RelationDetail | null {
+  const value = readDetail(metadata);
+  return value && endpoint(value["source"]) && endpoint(value["target"]) ? (value as unknown as RelationDetail) : null;
+}
+
+/** Permit web links without credentials and local final topic paths, never script or editor schemes. */
+export function detailHref(url: string | null): string | undefined {
+  if (!url || /[\u0000-\u0020\\]/u.test(url)) return undefined;
+  if (url.startsWith("/") && !url.startsWith("//")) return url;
+  if (!/^https?:\/\//u.test(url)) return undefined;
+  try {
+    const parsed = new URL(url);
+    return parsed.username || parsed.password ? undefined : url;
+  } catch {
+    return undefined;
+  }
+}
+
+/** Keep source labels useful in private and public output without exposing raw URLs. */
+export function sourceLabel(value: DetailSource): string {
+  return `${value.kind}: ${value.path}:${value.startLine}–${value.endLine}`;
+}
