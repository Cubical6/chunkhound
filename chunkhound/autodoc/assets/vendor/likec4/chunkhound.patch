+
+const relations = [
+  ["r-app-component", "system.app", "system.app.component", "found", "code"],
+  ["r-component-app", "system.app.component", "system.app", "documented", "doc"],
+  ["r-sys-app", "system", "system.app", "found", "code"],
+  ["r-app-sys", "system.app", "system", "documented", "doc"],
+  ["r-sys-component", "system", "system.app.component", "found", "code"],
+  ["r-component-sys", "system.app.component", "system", "documented", "doc"],
+  ["r-app-external", "system.app", "external", "found", "code"],
+  ["r-component-external", "system.app.component", "external", "documented", "doc"],
+] as const;
+
+const selections = {
+  focusApp: ["r-app-component", "r-component-app", "r-sys-app", "r-app-sys", "r-app-external"],
+  focusComponent: ["r-app-component", "r-component-app", "r-sys-component", "r-component-sys", "r-component-external"],
+  focusSystem: ["r-sys-app", "r-app-sys", "r-sys-component", "r-component-sys"],
+  topic: relations.map(([id]) => id),
+};
+
+const endpointIds: Record<string, string> = {
+  system: "sys",
+  "system.app": "app",
+  "system.app.component": "component",
+  external: "external",
+};
+
+function source(kind: string) {
+  return {
+    kind,
+    path: kind === "code" ? "component.py" : "README.md",
+    startLine: 2,
+    endLine: 7,
+    url: null,
+  };
+}
+
+const model = `
+  specification { element softwareSystem element container element component element externalSystem }
+  model {
+    system = softwareSystem 'System' {
+      app = container 'App' {
+        metadata { chunkhound_id 'app' }
+        component = component 'Component' { metadata { chunkhound_id 'component' } }
+      }
+    }
+    external = externalSystem 'External'
+    ${relations
+      .map(
+        ([id, from, to, status, kind]) => `
+      ${from} -> ${to} '${id}' {
+        metadata {
+          chunkhound_id '${id}'
+          chunkhound_detail ${JSON.stringify(JSON.stringify({ version: 1, status, sources: [source(kind)], source: { id: endpointIds[from], fqn: from, title: from }, target: { id: endpointIds[to], fqn: to, title: to } }))}
+        }
+      }
+    `,
+      )
+      .join("\n")}
+  }
+  views {
+    ${Object.entries(selections)
+      .map(
+        ([name, selected]) => `
+      view ${name} {
+        include system
+        include system.app
+        include system.app.component
+        include external
+        ${relations.map(([id, from]) => `exclude ${from} -> * where metadata.chunkhound_id = '${id}'`).join("\n")}
+        ${relations
+          .filter(([id]) => selected.includes(id))
+          .map(([id, from]) => `include ${from} -> * where metadata.chunkhound_id = '${id}'`)
+          .join("\n")}
+      }
+    `,
+      )
+      .join("\n")}
+  }
+`;
+
+function inventory(view: ComputedView | LayoutedView, all: Record<string, Relationship>) {
+  return view.edges
+    .flatMap((edge) => edge.relations.map((id) => nonNullable(nonNullable(all[id]).metadata)["chunkhound_id"]))
+    .sort();
+}
+
+function checkSelections(views: Record<string, ComputedView | LayoutedView>, all: Record<string, Relationship>) {
+  expect(inventory(nonNullable(views["focusApp"]), all)).toEqual(
+    ["r-app-component", "r-component-app", "r-sys-app", "r-app-sys", "r-app-external"].sort(),
+  );
+  expect(inventory(nonNullable(views["focusComponent"]), all)).toEqual(
+    ["r-app-component", "r-component-app", "r-sys-component", "r-component-sys", "r-component-external"].sort(),
+  );
+  expect(inventory(nonNullable(views["focusSystem"]), all)).toEqual(
+    ["r-sys-app", "r-app-sys", "r-sys-component", "r-component-sys"].sort(),
+  );
+  expect(inventory(nonNullable(views["topic"]), all)).toEqual(relations.map(([id]) => id).sort());
+  const directTopicTargetIds = nonNullable(views["topic"]).nodes.flatMap((node) => {
+    const id = node.metadata?.["chunkhound_id"];
+    return typeof id === "string" ? [id] : [];
+  });
+  expect(directTopicTargetIds.sort()).toEqual(["app", "component"]);
+  for (const name of Object.keys(selections)) {
+    const view = nonNullable(views[name]);
+    const system = nonNullable(view.nodes.find((node) => node.modelRef === "system"));
+    const app = nonNullable(view.nodes.find((node) => node.modelRef === "system.app"));
+    const component = nonNullable(view.nodes.find((node) => node.modelRef === "system.app.component"));
+    expect(app.parent).toBe(system.id);
+    expect(component.parent).toBe(app.id);
+    for (const edge of view.edges) {
+      for (const id of edge.relations) {
+        const actual = nonNullable(all[id]);
+        const expected = nonNullable(relations.find(([neutralId]) => neutralId === actual.metadata?.["chunkhound_id"]));
+        expect([actual.source, actual.target]).toEqual(expected.slice(1, 3).map((model) => ({ model })));
+        const detail = JSON.parse(nonNullable(actual.metadata)["chunkhound_detail"] as string);
+        expect(detail.status).toBe(expected[3]);
+        expect([detail.source.id, detail.target.id]).toEqual(expected.slice(1, 3).map((fqn) => endpointIds[fqn]));
+        expect(detail.sources).toEqual([source(expected[4])]);
+        expect([detail.source.fqn, detail.target.fqn]).toEqual(expected.slice(1, 3));
+      }
+    }
+  }
+}
