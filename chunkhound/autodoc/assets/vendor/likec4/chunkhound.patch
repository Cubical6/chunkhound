@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+import { Builder } from "../../builder";
+import { TestHelper } from "./__test__/TestHelper";
+
+describe("explicit boundary relationships", () => {
+  it("keeps direct relationships alongside expanded child relationships in both directions", () => {
+    const t = TestHelper.from(
+      Builder.specification({
+        elements: { el: {} },
+        metadataKeys: ["chunkhound_id"],
+      }).model(({ el, rel }, m) =>
+        m(
+          el("app"),
+          el("app.first"),
+          el("app.second"),
+          el("external"),
+          rel("app", "external", {
+            title: "Direct outgoing",
+            metadata: { chunkhound_id: "outgoing" },
+          }),
+          rel("app.first", "external", {
+            title: "Child outgoing",
+            metadata: { chunkhound_id: "child-outgoing" },
+          }),
+          rel("external", "app", {
+            title: "Direct incoming",
+            metadata: { chunkhound_id: "incoming" },
+          }),
+          rel("external", "app.second", {
+            title: "Child incoming",
+            metadata: { chunkhound_id: "child-incoming" },
+          }),
+          rel("app", "external", "Unmarked outgoing"),
+          rel("external", "app", "Unmarked incoming"),
+        ),
+      ),
+    );
+    const expanded = t.computeView(
+      TestHelper.$rules(t.$include("app"), t.$include("app.first"), t.$include("app.second"), t.$include("external")),
+    );
+    expect(expanded.edges.map((edge) => [edge.source, edge.target, edge.label]).sort()).toEqual(
+      [
+        ["app", "external", "Direct outgoing"],
+        ["app.first", "external", "Child outgoing"],
+        ["external", "app", "Direct incoming"],
+        ["external", "app.second", "Child incoming"],
+      ].sort(),
+    );
+    const collapsed = t.computeView(TestHelper.$rules(t.$include("app"), t.$include("external")));
+    expect(collapsed.edges.map((edge) => [edge.source, edge.target, edge.relations.length]).sort()).toEqual(
+      [
+        ["app", "external", 3],
+        ["external", "app", 3],
+      ].sort(),
+    );
+  });
+});
