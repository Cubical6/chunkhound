+                style={{ overflowWrap: "anywhere" }}
+              >
+                {sourceLabel(source)}
+              </Text>
+            );
+          })}
+        </Stack>
+      </ElementProperty>
+      <ElementProperty title="topics">
+        <Stack gap="xs">
+          {detail.topics
+            .toSorted((a, b) => b.weight - a.weight)
+            .map((topic, index) => (
+              <Text component="a" key={index} href={detailHref(topic.url)}>
+                {topic.title} ({topic.weight})
+              </Text>
+            ))}
+        </Stack>
+      </ElementProperty>
+      {onFocus && (
+        <ElementProperty title="view">
+          <UnstyledButton onClick={onFocus}>Focus</UnstyledButton>
+        </ElementProperty>
+      )}
+    </>
+  );
 }
